# =============================================================================
# Runtime image for canonical databuild GPU services.
#
# The image hosts the retained heavy components on one Python environment:
#   - Qwen3.5-35B-A3B local Responses serving through vGate
#   - instance-level SAM3 relabeling
#   - local GPU preset replay and OneAlign ranking
#
# Pipeline code and model weights
# WEIGHTS (/home/bc/data/models) are BIND-MOUNTED at runtime, NOT baked in. This image
# is the ENVIRONMENT only.
#
# BUILD (needs host network for the pip mirror — the default bridge has no egress here):
#   docker build --network=host \
#     -t veraretouch-unified:dev \
#     -f dataset_build/docker/Dockerfile.unified dataset_build/docker
#
# RUN (one container per GPU; bind-mount repo + models + add host net for the broker):
#   docker run -d --name vera_core_g0 --runtime nvidia --gpus '"device=0"' --network host \
#     -v /home/bc/VeraRetouch:/home/bc/VeraRetouch -v /home/bc/data:/home/bc/data \
#     -w /home/bc/VeraRetouch --entrypoint sleep veraretouch-unified:dev infinity
# =============================================================================
FROM vllm/vllm-openai:nightly

# Tsinghua PyPI mirror (host-reachable; pypi.org also works via --network=host).
ARG PIP_INDEX=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
ENV UV_INDEX_URL=${PIP_INDEX}
# Pipeline code is bind-mounted at this fixed path; expose the canonical package so
# the documented `python -m construct.agent ...` command remains exact in containers.
ENV PYTHONPATH=/home/bc/VeraRetouch/dataset_build/src:/home/bc/VeraRetouch

# uv for fast, resolved installs into the image's system python (/usr/bin/python3).
RUN pip install --no-cache-dir -i ${PIP_INDEX} uv

# Canonical transport is official typed Responses only. Caption and annotation
# share the repository's exact SDK pin; strict schemas intentionally use no JSON
# repair dependency. PostgreSQL remains ingest/viewer support, not resume state.
RUN uv pip install --system --python /usr/bin/python3 --index-url ${PIP_INDEX} \
        "openai==2.46.0" \
        "psycopg[binary]==3.2.13" \
        "scikit-learn==1.7.2" \
 && /usr/bin/python3 -c "import openai, psycopg, sklearn; assert openai.__version__ == '2.46.0'"

# default back to the base image's vllm entrypoint; the supervisor overrides
# --entrypoint per role (vLLM serve or canonical worker process).
