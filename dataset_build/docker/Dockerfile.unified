# =============================================================================
# Unified core image for the VeraRetouch dataset pipeline (v2 architecture).
#
# ONE image hosts every heavy component on ONE python env:
#   - vLLM serving (Qwen3.5-35B-A3B-FP8)      [from the base image, untouched]
#   - SAM3 text-promptable masker             [transformers 5.7 built-in Sam3* classes]
#   - VeraRetouch/LLaVA teacher renderer      [llava + diffusers + peft, runs on tf 5.7]
#   - pyiqa NR-IQA (MUSIQ/CLIP-IQA+/...)       [+ openai-clip/timm]
#
# WHY THIS WORKS (empirically validated 2026-06-16, see UNIFIED_CONCURRENCY_DESIGN_v2 §10):
#   The base image ships torch 2.11.0+cu130 / transformers 5.7.0 / py3.12. The old
#   split (base env tf4.57 for the renderer, monetgpt_sam3 tf5.2 for SAM3) existed
#   only because of mutually-incompatible PINS, NOT a hard runtime constraint:
#     * SAM3 needs transformers>=5.2  -> 5.7 has Sam3VideoModel/Sam3Processor/Sam3Model built-in (load OK).
#     * the LLaVA/Qwen2 renderer is PINNED to tf==4.57 in its requirements.txt but RUNS on 5.7:
#       teacher render parity vs base(4.57) = max|Δ|=2/255, PSNR 56.85 dB (rounding noise).
#     * pyiqa requires only torch>=1.13 / transformers>=4.36 (open) -> satisfied by the base image.
#   So we ADD the renderer/IQA deps on top WITHOUT touching torch/transformers/vllm.
#
# The pipeline CODE (dataset_build/, llava/, model/, configs/, data/) and the model
# WEIGHTS (/home/bc/data/models) are BIND-MOUNTED at runtime, NOT baked in. This image
# is the ENVIRONMENT only.
#
# BUILD (needs host network for the pip mirror — the default bridge has no egress here):
#   docker build --network=host \
#     -t veraretouch-unified:dev \
#     -f dataset_build/docker/Dockerfile.unified dataset_build/docker
#
# RUN (one container per GPU; bind-mount repo + models + add host net for the broker):
#   docker run -d --name vera_core_g0 --runtime nvidia --gpus '"device=0"' --network host \
#     -v /home/bc/VeraRetouch:/home/bc/VeraRetouch -v /home/bc/data:/home/bc/data \
#     -w /home/bc/VeraRetouch --entrypoint sleep veraretouch-unified:dev infinity
# =============================================================================
FROM vllm/vllm-openai:nightly

# Tsinghua PyPI mirror (host-reachable; pypi.org also works via --network=host).
ARG PIP_INDEX=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
ENV UV_INDEX_URL=${PIP_INDEX}

# uv for fast, resolved installs into the image's system python (/usr/bin/python3).
RUN pip install --no-cache-dir -i ${PIP_INDEX} uv

# Renderer (LLaVA/Qwen2 teacher) + pyiqa deps. EXACT versions matched to the proven
# base env. These are pure-python / open-dep packages that do NOT pull a different
# torch/torchvision/transformers (the image's 2.11 / 0.26 / 5.7 satisfy them).
#   python-box, attrdict3  -> configs/renderer_config.py, utils.py
#   peft==0.15.0           -> model/colormlp_v2.py (LoRA)
#   diffusers==0.34.0      -> model/retouch_render.py (UNet2DConditionModel)
#   timm==1.0.24           -> vision tower / pyiqa
#   pyiqa                  -> NR-IQA (pulls openai-clip)
# NOTE: SAM3's MODEL needs no extra dep (built into transformers 5.7). SAM3's
# Sam3Processor tokenizer.json on disk is currently MALFORMED (breaks on tf 5.2 AND
# 5.7 alike — a pre-existing data issue, not an image issue); fix the tokenizer
# before running LIVE SAM3. Stage-0 SAM3 mask cache already exists, so build is unblocked.
RUN uv pip install --system --python /usr/bin/python3 --index-url ${PIP_INDEX} \
        python-box \
        attrdict3 \
        "peft==0.15.0" \
        "diffusers==0.34.0" \
        "timm==1.0.24" \
        pyiqa \
 && /usr/bin/python3 -c "import transformers,torch,torchvision; \
print('post-install: transformers',transformers.__version__,'torch',torch.__version__,'torchvision',torchvision.__version__)"

# default back to the base image's vllm entrypoint; the supervisor overrides
# --entrypoint per role (vllm serve / sleep for the core-worker+business shard).
