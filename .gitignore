# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Docs: keep curated module docs (docs/<module>/*.md) in git, but exclude the
# heavy research corpus living under docs/ (PDF bundles, extracted papers, plans).
docs/*.zip
docs/papers_extracted/
docs/plan/
docs/paper_list.md

# Local build outputs / scratch
*.tmp
.DS_Store

# LR render service caches (regeneratable)
lrc_scripts/servers/lr_caches/
lrc_scripts/**/__pycache__/
dataset_build/source_qa/render_stage/
lrc_scripts/
