# 实验数据产物（可由 manifest+seed 确定性重生成，勿入 git）
experiments/tooling-wave1/T4_construct/sanity/
experiments/tooling-wave1/scache/s_cache/
experiments/*/run_full/
experiments/*/run_regfull/
